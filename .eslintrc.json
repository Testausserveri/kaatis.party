{
    "env": {
        "es2021": true,
        "node": true,
        "browser": true
    },
    "extends": [
        "airbnb-base"
    ],
    "parserOptions": {
        "ecmaVersion": 12,
        "sourceType": "module"
    },
    "rules": {
        "semi": "off",
        "no-console": "off",
        "no-restricted-syntax": "off",
        "import/extensions": "off",
        "import/no-unresolved": "off",
        "import/prefer-default-export": "off",
        "no-await-in-loop": "off",
        "no-bitwise": "off",
        "no-continue": "off",
        "object-curly-newline": "off"
    }
}
