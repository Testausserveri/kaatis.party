DISCORD_BOT_TOKEN=
MEME_CHANNEL_ID=

# Optional (defaults shown)
# UPLOAD_DIR=public/
# MEDIA_DB_PATH=data/kaatis.sqlite
# HTTP_PORT=8080
# PUBLIC_BASE_URL=https://kaatis.party

# Discord semantic meme reply command
# DISCORD_GUILD_ID=
# DISCORD_REGISTER_SLASH_COMMANDS=true
# MEME_SEARCH_URL=http://search:3000/api/search
# MEME_INDEX_URL=http://search:3000/api/index
# MEME_CONTEXT_LIMIT=10
# MEME_FETCH_LIMIT=12
# MEME_QUERY_MAX_LENGTH=480
# MEME_SEARCH_LIMIT=6
# MEME_RANDOM_POOL_LIMIT=4
# MEME_RANDOM_SCORE_DELTA=0.035
# MEME_SEARCH_LOG_CONTEXT=true
# GEMINI_QUERY_MODEL=gemini-3.5-flash-lite
# SEARCH_INTERNAL_TOKEN=

# Semantic image search
# GEMINI_API_KEY=
# QDRANT_URL=http://qdrant:6333
# QDRANT_COLLECTION=kaatis_images
# QDRANT_QUERY_CACHE_COLLECTION=kaatis_images_query_cache
# GEMINI_EMBED_MODEL=gemini-embedding-2
# GEMINI_EMBED_DIMS=768
# SEARCH_EMBEDDING_INPUT_VERSION=image-metadata-v2
# SEARCH_API_PORT=3000
# SEARCH_HOST_PORT=3095
# SEARCH_MIN_QUERY_LENGTH=2
# SEARCH_MIN_SCORE=0.4
# SEARCH_PERSIST_QUERY_CACHE=true
# SEARCH_QUERY_CACHE_MAX_ENTRIES=1000
# SEARCH_QUERY_CACHE_TTL_MS=0
# SEARCH_RATE_LIMIT_WINDOW_MS=60000
# SEARCH_RATE_LIMIT_MAX=60
# SEARCH_GLOBAL_RATE_LIMIT_MAX=300
# SEARCH_INDEX_CONCURRENCY=2
# SEARCH_INDEX_LIMIT=25
# SEARCH_INDEX_MATCH=
# SEARCH_DELETE_STALE=true
