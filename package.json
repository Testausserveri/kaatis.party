{
  "name": "kaatis",
  "version": "2.0.0",
  "description": "kaatis.party media archive",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "csv-parse": "^7.0.1",
    "dotenv": "^9.0.2"
  },
  "devDependencies": {
    "eslint": "^7.27.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-plugin-import": "^2.23.3"
  },
  "scripts": {
    "test": "node --test",
    "start": "npm run start --workspace @kaatis/api",
    "dev": "npm run dev --workspace @kaatis/web",
    "build": "npm run build --workspace @kaatis/web",
    "api:start": "npm run start --workspace @kaatis/api",
    "bot:start": "npm run start --workspace @kaatis/bot",
    "media:migrate": "node src/migrateMediaStore.js",
    "media:reconcile": "node src/reconcileMediaStore.js",
    "media:backfill": "npm run backfill --workspace @kaatis/api",
    "media:migrate-batches": "npm run migrate-batches --workspace @kaatis/api",
    "search:start": "npm run start --workspace @kaatis/api",
    "search:index": "node src/search/indexer.js",
    "search:index:video-batch": "node src/search/batchIndexer.js"
  },
  "keywords": [
    "discord",
    "bot",
    "kaatis",
    "testausserveri",
    "highlife"
  ],
  "author": "Testausserveri.fi",
  "license": "MIT"
}
