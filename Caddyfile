:80 {
	encode zstd gzip

	header {
		-Server
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
	}

	@internal path /internal/*
	respond @internal 404

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /thumbs/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@incoming path /.incoming/*
	respond @incoming 404

	@media {
		path /*.jpg /*.jpeg /*.png /*.gif /*.webp /*.bmp /*.svg /*.ico /*.tiff /*.tif /*.heic /*.heif /*.avif /*.mp4 /*.webm /*.mov /*.avi /*.mkv /*.flv /*.wmv /*.m4v /*.3gp /*.ogv /*.mp3 /*.wav /*.ogg /*.flac /*.m4a /*.aac /*.wma /*.aiff
		file {
			root /srv/media
			try_files {path}
		}
	}
	handle @media {
		root * /srv/media
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle /assets/* {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		header Cache-Control "no-store"
		file_server
	}

	log {
		output stdout
		format json
	}
}
